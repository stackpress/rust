{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackpress Profile M0",
  "version": "0.1.0",
  "identifier": "dev.stackpress.profile-m0",
  "build": { "frontendDist": "../dist/csr" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["main-search"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png"] }
}
